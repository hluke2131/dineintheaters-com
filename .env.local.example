# Supabase
# Project Settings > API in the Supabase dashboard
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Google (not needed until a later session)
GOOGLE_MAPS_API_KEY=
GOOGLE_PLACES_API_KEY=

# Google Maps Embed API - powers the map on a listing page. Not yet
# restricted by HTTP referrer (see src/app/dine-in-theaters/[slug]/page.tsx)
# - do that in Google Cloud Console once the production domain is final.
GOOGLE_MAPS_EMBED_API_KEY=

# Fandango CJ (Commission Junction) affiliate deep-link template for the
# "Check Showtimes" CTA. Must contain a literal `{destination}` placeholder,
# e.g. https://www.dpbolvw.net/click-XXXXXX?url={destination}
# Left unset until the real CJ link is available; ticketing_url links
# directly until then.
FANDANGO_CJ_DEEP_LINK_TEMPLATE=

# Stripe (not needed until a later session)
STRIPE_SECRET_KEY=
STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=
